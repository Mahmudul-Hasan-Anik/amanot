{
  "expo": {
    "name": "আমানত - সমিতি হিসাব ও ম্যানেজমেন্ট",
    "slug": "amanot",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "primaryColor": "#0F5E4A",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0F5E4A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.amanot.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.amanot.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0F5E4A"
      },
      "permissions": [
        "NOTIFICATIONS"
      ]
    },
    "scheme": "amanot",
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-font",
      "expo-print"
    ]
  }
}
