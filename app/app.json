{
  "expo": {
    "name": "আমানত - সমিতি হিসাব ও ম্যানেজমেন্ট",
    "slug": "amanot",
    "version": "1.0.2",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "primaryColor": "#0F5E4A",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0F5E4A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.amanot.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.amanot.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#0F5E4A"
      },
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "scheme": "amanot",
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "সদস্যের প্রোফাইল ছবি নির্বাচন করতে অনুমতি দিন।",
          "cameraPermission": "সদস্যের ছবি তুলতে ক্যামেরার অনুমতি দিন।",
          "microphonePermission": false
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "owner": "anik13dev",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9c005cec-297a-4c2d-b7bd-487445515c11"
      }
    }
  }
}
