{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "true"
      }
    },
    "release": {
      "distribution": "internal",
      "environment": "production",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_DEMO_MODE": "false" }
    },
    "production": {
      "environment": "production",
      "env": { "EXPO_PUBLIC_DEMO_MODE": "false" },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      }
    }
  },
  "submit": {
    "production": {}
  }
}
